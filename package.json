{
  "name": "cmux-git-review",
  "version": "0.1.0",
  "description": "Git review & history panel for the cmux right-sidebar Dock",
  "type": "module",
  "bin": {
    "cmux-review": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p . && chmod +x dist/cli.js && node scripts/build-web.mjs",
    "typecheck": "tsc -p . --noEmit && tsc -p web --noEmit",
    "test": "node --test \"dist/test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
